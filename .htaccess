<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to hidden files and directories (e.g. .env, .git)
    RewriteRule ^\.(.*)$ - [F,L]

    # 2. Block access to sensitive configuration, database, log, and metadata files
    RewriteRule ^(composer\.(json|lock)|package\.json|pnpm-lock\.yaml|artisan|phpunit\.xml|.*\.md|.*\.pdf|.*\.sql|.*\.sqlite|.*\.log)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/.*)?$ - [F,L]

    # 3. Allow direct access to menu directory
    RewriteCond %{REQUEST_URI} !^/?menu
    RewriteCond %{REQUEST_URI} !^public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>