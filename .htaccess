<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to hidden files and directories (allow .well-known for SSL certificates)
    RewriteRule ^\.(?!well-known)(.*)$ - [F,L]

    # 2. Block access to sensitive configuration, database, log, and metadata files
    RewriteRule ^(composer\.(json|lock)|package\.json|pnpm-lock\.yaml|artisan|phpunit\.xml|.*\.md|.*\.pdf|.*\.sql|.*\.sqlite|.*\.log)$ - [F,L]

    # 3. Block access to internal application directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor|node_modules)(/.*)?$ - [F,L]

    # 4. Block access to private storage (framework cache, logs, private app files)
    RewriteRule ^storage/(framework|logs|app/private)(/.*)?$ - [F,L]

    # 5. Allow direct access to menu directory
    RewriteCond %{REQUEST_URI} !^/?menu

    # 6. Rewrite all other traffic to public/
    RewriteCond %{REQUEST_URI} !^public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>